# .env.example — Copy this to .env and fill in real values
# NEVER commit .env to version control

# AWS credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# For local development with LocalStack
# AWS_ENDPOINT_URL=http://localhost:4566

# EIA API Key (get free key at https://www.eia.gov/opendata/)
EIA_API_KEY=your_eia_api_key_here

# MLflow
MLFLOW_TRACKING_URI=http://mlflow-server:5000

# Airflow
AIRFLOW__CORE__FERNET_KEY=your_fernet_key_here

# Alerts
ALERT_EMAIL=your_email@example.com

# S3
DATA_LAKE_BUCKET=energy-trading-mlops-data
AIRFLOW_DAGS_BUCKET=energy-trading-mlops-airflow
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:ACCOUNT_ID:energy-trading-mlops-alerts
