###############################################################################
# Dockerfile.airflow
# Extends the official Airflow image with this project's dependencies, so
# DAG tasks (which import loguru, mlflow, boto3, gymnasium, stable-baselines3,
# etc.) can actually run inside the Airflow scheduler/webserver containers.
###############################################################################

FROM apache/airflow:2.8.1-python3.11

COPY requirements.txt /requirements.txt

# Install CPU-only torch first: this container has no GPU, and the default
# PyPI torch wheel drags in several GB of unused CUDA/cuDNN/NCCL packages.
# Optional build secret `pip_ca`: a CA bundle for networks that intercept HTTPS (e.g. antivirus
# web shields). Without the secret the build uses the normal certificates.
RUN --mount=type=secret,id=pip_ca,target=/tmp/pip_ca.pem,uid=50000,mode=0444 \
    if [ -f /tmp/pip_ca.pem ]; then export PIP_CERT=/tmp/pip_ca.pem; fi \
 && pip install --no-cache-dir --default-timeout=300 --retries 10 torch==2.12.0 --index-url https://download.pytorch.org/whl/cpu \
 && pip install --no-cache-dir --default-timeout=300 --retries 10 -r /requirements.txt

# MLflow 3.x imports pydantic EmailStr, which needs email-validator >= 2 (the Airflow 2.8.1 image ships 1.3.1;
# Flask-AppBuilder only calls validate_email, which v2 keeps).
RUN --mount=type=secret,id=pip_ca,target=/tmp/pip_ca.pem,uid=50000,mode=0444 \
    if [ -f /tmp/pip_ca.pem ]; then export PIP_CERT=/tmp/pip_ca.pem; fi \
 && pip install --no-cache-dir --default-timeout=300 --retries 10 "email-validator>=2.0"
