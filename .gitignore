# ── Secrets ──────────────────────────────────────────────────────────────────
# Real credentials live only in .env (copy .env.example and fill it in).
.env
.env.*
!.env.example

# ── Python build / test artefacts ────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# ── Training outputs ─────────────────────────────────────────────────────────
# Intermediate checkpoints are regenerated by training; the models used in the
# report are kept as MLflow artefacts under mlruns/ (which IS committed, because
# Chapter 5 reproduces its results from those runs).
checkpoints/
mlruns/.trash/

# ── Infrastructure state (may contain secrets) ───────────────────────────────
terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
crash.log

# ── Airflow / Docker local data ──────────────────────────────────────────────
logs/
airflow-data/
localstack-data/

# ── Office / OS clutter ──────────────────────────────────────────────────────
~$*
*.tmp
.DS_Store
Thumbs.db
desktop.ini

# ── Local tool settings ──────────────────────────────────────────────────────
.vscode/

# ── Course material and local backups (not the student's own work) ──────────
Research Writing for CS 2 Projects*.pdf
presentation.txt
slides.md
docs/report/backup/

# ── Machine-specific Docker overrides (antivirus HTTPS-scanning certificate) ──
docker-compose.override.yml
docker/local-certs/

# ── Dashboard build output (published by .github/workflows/pages.yml) ──────────
site/

# Signed copy of the report (handwritten signature) - kept local, never published
*_signed.docx

# Live paper-trading demo (demo/app.py): scratch ledger and EIA cache
reports/demo/workspace/
reports/demo/eia_cache.*
